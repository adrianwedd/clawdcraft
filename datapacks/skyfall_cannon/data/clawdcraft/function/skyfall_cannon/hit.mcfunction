# Runs as the attacking player, same tick as the hit (advancement reward).
advancement revoke @s only clawdcraft:skyfall_cannon_hit
execute unless score @s clawdcraft_skyfallcd matches 1.. at @s as @e[type=!minecraft:player,type=!minecraft:armor_stand,type=!minecraft:item,type=!minecraft:item_display,type=!minecraft:ender_dragon,type=!minecraft:wither,type=!minecraft:warden,type=!minecraft:villager,type=!minecraft:wandering_trader,type=!minecraft:wolf,type=!minecraft:cat,type=!minecraft:horse,type=!minecraft:donkey,type=!minecraft:mule,type=!minecraft:llama,type=!minecraft:trader_llama,type=!minecraft:camel,type=!minecraft:parrot,type=!minecraft:allay,distance=..8,limit=1,sort=nearest,nbt={HurtTime:10s}] at @s run function clawdcraft:skyfall_cannon/launch
execute unless score @s clawdcraft_skyfallcd matches 1.. run scoreboard players set @s clawdcraft_skyfallcd 40

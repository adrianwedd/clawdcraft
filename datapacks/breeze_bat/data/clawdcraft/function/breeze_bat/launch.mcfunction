# Runs as each launched hostile, at it. Levitation VII for 1s is the pop
# (~6 blocks up); slow falling outlasts the hang so the landing never
# deals fall damage.
effect give @s minecraft:levitation 1 6 true
effect give @s minecraft:slow_falling 8 0 true
particle minecraft:cloud ~ ~0.2 ~ 0.3 0.2 0.3 0.05 8
